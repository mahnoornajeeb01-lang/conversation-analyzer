ALLOWED_ORIGINS=["http://localhost:3000"]
WHISPER_MODEL=small
HUGGINGFACE_TOKEN=your_token_here
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
USE_MOCK_DIARIZATION=false
MAX_UPLOAD_SIZE_MB=200
FLOOR_TRANSFER_THRESHOLD_SECONDS=0.5

# "local" runs the models above on this machine; "pyannoteai" uses pyannoteAI's hosted API
# (diarization + speech-to-text), as on Render. Key: https://dashboard.pyannote.ai
ANALYSIS_ENGINE=local
PYANNOTEAI_API_KEY=
